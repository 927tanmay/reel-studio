{
  "name": "reel-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A general-purpose short-form video editor driven by a coding agent: footage and a brief in, a verified vertical video out.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/927tanmay/reel-studio.git" },
  "homepage": "https://github.com/927tanmay/reel-studio#readme",
  "engines": { "node": ">=22" },
  "scripts": {
    "studio": "remotion studio",
    "ingest": "node scripts/ingest.mjs",
    "grade": "node scripts/grade.mjs",
    "beats": "node scripts/beats.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "tighten": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tighten.mjs",
    "align": "node scripts/align.mjs",
    "beatcheck": "node scripts/beatcheck.mjs",
    "critique": "node scripts/critique.mjs",
    "render": "node scripts/render.mjs",
    "thumbnail": "node scripts/thumbnail.mjs",
    "verify": "node scripts/verify.mjs",
    "takes": "node scripts/takes.mjs",
    "export-timeline": "node scripts/export-timeline.mjs",
    "new": "node scripts/new-post.mjs",
    "test": "node --experimental-strip-types --experimental-loader ./scripts/ts-resolve-hook.mjs --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.523",
    "@remotion/cli": "^4.0.523",
    "@remotion/fonts": "^4.0.523",
    "@remotion/layout-utils": "^4.0.523",
    "@remotion/lottie": "^4.0.523",
    "@remotion/media-utils": "^4.0.523",
    "@remotion/paths": "^4.0.523",
    "@remotion/rough-notation": "^4.0.523",
    "@remotion/shapes": "^4.0.523",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.523",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
